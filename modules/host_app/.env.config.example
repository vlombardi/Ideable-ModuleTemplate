############################
# host_app Module Settings  #
############################

# ════════════════════════════════════════════════════════════════
#  Ports & Paths
# ════════════════════════════════════════════════════════════════

######################
# Hosts configurations #
######################
MAIN_HOST=localhost
DATABASE_IP=${MAIN_HOST}

################################
# TLS / Reverse Proxy (Traefik) #
################################
# Manual certificate paths inside the Traefik container (used when TLS_MODE=manual)
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem

# Traefik entrypoint ports on the host (canonical values in project.env.config)
TRAEFIK_HTTP_PORT=${HOSTAPP_TRAEFIK_HTTP_PORT:-80}
TRAEFIK_HTTPS_PORT=${HOSTAPP_TRAEFIK_HTTPS_PORT:-443}
TRAEFIK_DASHBOARD_PORT=${HOSTAPP_TRAEFIK_DASHBOARD_PORT:-8088}

#################
# Service Ports #
#################
# All exposed port values are defined in project.env.config and referenced here.
# Use configure.sh to change them without editing this file.

# Frontend
FRONTEND_EXTERNAL_PORT=3001
FRONTEND_PORT=${HOSTAPP_FRONTEND_PORT:-3000}
AUTHENTIK_PORT_HTTP=${HOSTAPP_AUTHENTIK_HTTP_PORT:-9000}
AUTHENTIK_PORT_HTTPS=${HOSTAPP_AUTHENTIK_HTTPS_PORT:-9443}

# Backend
BACKEND_PORT=${HOSTAPP_BACKEND_PORT:-8001}

##########################
# Frontend Configuration #
##########################
FRONTEND_CERT_HOSTS=${MAIN_HOST},localhost,127.0.0.1,${EXTERNAL_BASE_HOST}
FRONTEND_CERT_IP=${MAIN_HOST}

##########################
# Database Configuration #
##########################
POSTGRES_HOST=${DATABASE_IP}
POSTGRES_USER=ideable_db_user
POSTGRES_DB=ideable_db
# External exposed port (canonical value in project.env.config)
POSTGRES_PORT=${HOSTAPP_POSTGRES_PORT:-5433}
# Host interface the database port is published on. Loopback keeps the DB unreachable
# from outside the host (host-run test suites connect via localhost and keep working).
# Set to 0.0.0.0 only if a remote client genuinely must reach the DB directly; in
# production prefer keeping this on loopback or dropping the mapping from compose entirely.
POSTGRES_BIND=127.0.0.1
# Connection string (external access potentially? No, typically internal for services. But usually internal is hostname based port 5432)
# Here DATABASE_URL uses POSTGRES_PORT, careful. If external, use 5433. If internal, usually hardcoded to database:5432 in docker-compose.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

###########################
# Authentik Configuration #
###########################
# External URL at which Authentik is exposed (path-based under the main host)
AUTHENTIK_EXTERNAL_URL=https://${EXTERNAL_BASE_HOST}/auth

# Authentik database — its OWN dedicated instance, NOT the application's Timescale/Postgres.
AUTHENTIK_POSTGRES_HOST=authentik-database
AUTHENTIK_POSTGRES_PORT=5432 # Internal port

# --- identity plane -----------------------------------------------------------------------
# Authentik has its OWN database. Sharing the application Postgres meant login and session traffic
# competed with application queries for the same connections and buffer pool — and an application-side
# database problem also stopped anyone logging in to fix it.
#
# There is no cache tier and there must not be one: Authentik 2025.10 removed Redis support entirely and
# keeps sessions, cache, tasks and WebSocket channels in this database. It is therefore both the shared
# store that makes replication safe and the identity plane's single point of failure.
AUTHENTIK_POSTGRES_VERSION=16-alpine
AUTHENTIK_POSTGRES_BIND=127.0.0.1
# Published on the host ONLY so a restore can be driven from there (RUNBOOK § Identity database
# restore). Distinct from the application's 5433 and the module's 5434.
AUTHENTIK_POSTGRES_PUBLISHED_PORT=5435
AUTHENTIK_DATABASE_CPU_LIMIT=1
AUTHENTIK_DATABASE_MEM_LIMIT=1g
AUTHENTIK_DATABASE_MEM_RESERVATION=256m

# Connection ceiling for the identity database. Since Authentik 2025.10 this instance carries ALL
# identity state — sessions, cache, task queue and WebSocket channels — which costs ~50% more
# connections than a pre-2025.10 install, and each added replica brings its own set. Measured: 11 client
# connections for one server + one worker. Budget ~15 per server+worker replica pair plus ~20 for the
# bootstrap, operators and a restore. There is NO Redis: Authentik 2025.10 removed it entirely.
AUTHENTIK_POSTGRES_MAX_CONNECTIONS=200

# Identity-plane replicas. `authentik-server` is stateless because all session state lives in the
# identity Postgres, so any replica can serve any user's next request; the worker drains an event queue,
# so size it to event load rather than request load.
AUTHENTIK_SERVER_REPLICAS=1
AUTHENTIK_PUBLISH_HTTP=9000:9000
AUTHENTIK_PUBLISH_HTTPS=9443:9443
# scaling the identity plane: widen BOTH together with AUTHENTIK_SERVER_REPLICAS, e.g.
#   AUTHENTIK_SERVER_REPLICAS=2
#   AUTHENTIK_PUBLISH_HTTP=9000-9001:9000
#   AUTHENTIK_PUBLISH_HTTPS=9443-9444:9443
AUTHENTIK_WORKER_REPLICAS=1
# The worker no longer runs as root. This uid must own the media/templates volume.
AUTHENTIK_WORKER_UID=1000

# ════════════════════════════════════════════════════════════════
#  Params
# ════════════════════════════════════════════════════════════════

# Module identity (module-local)
MODULE_SLUG=hostapp
MODULE_NAME=host_app

# Registry prefix for this module's images (used by push script and compose references).
# When set, compose image references include this prefix with a slash separator:
#   image: ${MODULE_DOCKER_REGISTRY_PREFIX}/${MODULE_SLUG}.backend:latest
# The value should NOT include a trailing slash (e.g. ghcr.io/OWNER).
# Note: when this module is declared as "local" (not "remote") in modules/enabled.md,
# the deploy script strips the prefix at compose generation time so compose uses locally built images.
# Leave empty for local builds (no registry prefix).
MODULE_DOCKER_REGISTRY_PREFIX=ghcr.io/vlombardi

# When true, the app name is shown in the host_app header next to the logo.
# When false, only the logo is displayed and the app name is hidden.
SHOW_APP_NAME_ON_HEADER=true

AUTHENTIK_LOGIN_BG_IMAGE_FILE=config/login_bg.png
AUTHENTIK_LOGIN_FAVICON_FILE=config/favicon.png
AUTHENTIK_LOGIN_BG_COLOR="#ffffff"

# Internationalization
# System-wide default language (used as fallback when user/tenant default_language is not set)
DEFAULT_LANGUAGE=en
VITE_DEFAULT_LANGUAGE=${DEFAULT_LANGUAGE}

# OIDC client_id used by Authentik for the OAuth2/OIDC application.
CLIENT_ID=${APP_SLUG}-client

# Mode for TLS certificates at the reverse proxy.
# Supported values (for now):
#   letsencrypt - Traefik obtains certificates via Let's Encrypt ACME
#   manual      - Traefik uses certificates mounted into the container
TLS_MODE=letsencrypt

# Let's Encrypt configuration (used when TLS_MODE=letsencrypt)
LE_EMAIL=admin@ideable.tech
ACME_EMAIL=${LE_EMAIL}
LE_STAGING=true

TRAEFIK_LOG_LEVEL=INFO

###########################
# Authentik Configuration #
###########################
# Bootstrap admin user for Authentik (set real values only in .env.secrets)
AUTHENTIK_BOOTSTRAP_EMAIL=sadmin@localhost

# Backend Authentik API settings used by the FastAPI backend
AUTHENTIK_JWKS_URL=http://authentik-server:9000/application/o/${APP_SLUG}/jwks/

# How long a fetched JWKS stays fresh, in seconds (default 600). An unknown `kid` also
# forces a refresh, so an Authentik signing-key rotation self-heals without a restart.
AUTHENTIK_JWKS_TTL_SECONDS=600
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3

AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=${POSTGRES_USER}

SADMIN_IS_SUPERUSER=true

# --- horizontal scale ---------------------------------------------------------------------
# See modules/module_template/.env.config for the full note. Replicas are 1 by default, so an
# unconfigured deployment behaves exactly as it did before this was introduced.
# The *_PUBLISH keys are the compose port spec, as ONE value, so scaling is an explicit decision:
# `8002:8002` guarantees the documented port (the default, today's behaviour); `8002-8004:8002` is a
# range for >1 replica, at the cost of the base port no longer being guaranteed — measured: with a
# range and one replica, Compose bound the LAST port and left the documented one dead. Raise the
# replica count and widen the publish spec together, and remember that anything pinned to the base
# port must then go through Traefik instead.
BACKEND_REPLICAS=1
BACKEND_PUBLISH=8001:8001
# scaling: BACKEND_PUBLISH=8001-8003:8001
FRONTEND_REPLICAS=1
FRONTEND_PUBLISH=3000:80
# scaling: FRONTEND_PUBLISH=3000-3002:80

# --- execution mode -----------------------------------------------------------------------
# dev (default) or prod. The ONLY difference is how the deterministic admin account `sadmin` is
# treated, and it exists because the bootstrap used to reset that password on EVERY deploy — so an
# operator who changed it had the change silently reverted by the next redeploy.
#
#   dev   the password is re-set from SADMIN_PASSWORD on every deploy (convenient, throwaway)
#   prod  an existing password is PRESERVED; the deploy REFUSES to run on a known-default or
#         short SADMIN_PASSWORD; an Authentik password-expiry policy forces a change at first login
#
# If sadmin's password is lost in prod, reset it as Authentik admin (akadmin) in the Authentik UI —
# see modules/host_app/SPECS/auth-specs.md § "Privileged access".
IDEABLE_EXECUTION_MODE=dev

# How often privileged access must be reviewed (ISO 27001 A.5.18 / A.8.2). Reported by
# GET /api/access_review/privileged so a reviewer can see whether the review is due. A value here
# rather than in a spec: the cadence is a deployment's decision, and a document that hard-codes one
# goes stale the moment a deployment picks another.
PRIVILEGED_ACCESS_REVIEW_PERIOD_DAYS=90

# Authentik provider token lifetimes use the Authentik duration format:
#   seconds=30, minutes=5, hours=1, days=30

# AUTHENTIK_ACCESS_CODE_VALIDITY: short-lived authorization code issued during the
#   login redirect flow; keep this short because it is exchanged immediately.
AUTHENTIK_ACCESS_CODE_VALIDITY=minutes=1

# AUTHENTIK_ACCESS_TOKEN_VALIDITY: lifetime of the access token used on API calls;
#   increase this if users are being logged out too quickly.
#   Example: AUTHENTIK_ACCESS_TOKEN_VALIDITY=hours=8
AUTHENTIK_ACCESS_TOKEN_VALIDITY=minutes=5

# AUTHENTIK_REFRESH_TOKEN_VALIDITY: lifetime of the refresh token used for silent
#   renew; keep this longer than the access token so refresh can continue working.
AUTHENTIK_REFRESH_TOKEN_VALIDITY=days=30

#########################
# Backend Auth Settings #
#########################
# Internal URL to reach Authentik from backend container (for JWKS fetching)
AUTHENTIK_INTERNAL_URL=http://authentik-server:9000

# JWKS URL is derived automatically: ${AUTHENTIK_INTERNAL_URL}/application/o/${APP_SLUG}/jwks/
# Override only if your provider slug differs.
# AUTHENTIK_JWKS_URL=http://authentik-server:9000/application/o/digitalshelter/jwks/

# Set to "false" in local dev to skip JWT signature validation (default: true)
JWT_VALIDATION_ENABLED=true

# Comma-separated list of public (unauthenticated) backend paths
PUBLIC_PATHS=/health,/openapi.json

#########################
# Frontend Configuration #
#########################
VITE_APP_TITLE=${APP_NAME}
VITE_SHOW_APP_NAME_ON_HEADER=${SHOW_APP_NAME_ON_HEADER}
VITE_API_URL=https://${EXTERNAL_BASE_HOST}/api
VITE_OIDC_AUTHORITY=https://${EXTERNAL_BASE_HOST}/application/o/${APP_SLUG}/
VITE_OIDC_CLIENT_ID=${CLIENT_ID}
VITE_OIDC_REDIRECT_URI=https://${EXTERNAL_BASE_HOST}/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://${EXTERNAL_BASE_HOST}

#########################
# Backend Configuration #
#########################
# CORS - Set to "true" only in development to allow all origins
# In production, only EXTERNAL_BASE_HOST and localhost will be allowed
CORS_ALLOW_ALL=false

# Application Versions
TIMESCALEDB_VERSION=2.18.2-pg16
NODE_JS_VERSION=18
AUTHENTIK_VERSION=2025.10.4
IDEABLE_VERSION=latest

##############################################
# Container resource limits (deploy.resources) #
##############################################
# Caps, not reservations of capacity: they contain a runaway container so one
# misbehaving service cannot get Postgres, Authentik or Traefik OOM-killed.
# Memory reservations are soft (scheduling hints). Raise the limits for a busier
# deployment; keep them set — an unlimited container is the failure mode these
# values exist to prevent.

DATABASE_CPU_LIMIT=2
DATABASE_MEM_LIMIT=2g
DATABASE_MEM_RESERVATION=512m

BACKEND_CPU_LIMIT=1
BACKEND_MEM_LIMIT=1g
BACKEND_MEM_RESERVATION=256m

FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256m
FRONTEND_MEM_RESERVATION=64m

AUTHENTIK_SERVER_CPU_LIMIT=2
AUTHENTIK_SERVER_MEM_LIMIT=2g
AUTHENTIK_SERVER_MEM_RESERVATION=512m

AUTHENTIK_WORKER_CPU_LIMIT=2
AUTHENTIK_WORKER_MEM_LIMIT=2g
AUTHENTIK_WORKER_MEM_RESERVATION=512m

TRAEFIK_CPU_LIMIT=1
TRAEFIK_MEM_LIMIT=512m
TRAEFIK_MEM_RESERVATION=128m

# --- Backend concurrency and DB pool ------------------------------------------------------
# Workers are processes: each one owns its own connection pool, so total connections are
# BACKEND_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW). Keep that under the database's
# max_connections (see the backend framework spec).
BACKEND_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# Per-identity write limit, counted per worker (0 disables it).
RATE_LIMIT_WRITES_PER_MINUTE=120

# ── E2E test accounts (config/test-users.yaml) ──────────────────────────────────────────────
# Dedicated, clearly-named personas the end-to-end suite authenticates as, so the tests never
# drive a production account. They also make DENIAL testable: `e2e_no_module` holds a host_app
# profile and no module permissions, which is what proves a page is hidden from someone who may
# not see it. A suite that only has an all-powerful account can only ever assert "allowed".
#
# TWO gates, both required, because these accounts have a known password:
#   E2E_TEST_USERS_ENABLED=true      explicit opt-in (default false)
#   IDEABLE_EXECUTION_MODE != prod   refused in production regardless of the flag
#
# The password itself lives in .env.secrets as E2E_TEST_PASSWORD. No password, no accounts.
E2E_TEST_USERS_ENABLED=true

# Whether config/bootstrap-users.yaml is applied at all. Set false once a directory is connected
# and every account comes from upstream.
BOOTSTRAP_USERS_ENABLED=true

# --- Operational tunables (optional; the defaults shown are the code defaults) ------------
# Identity sync retry backoff, and the identity-event de-duplication window.
#IDENTITY_SYNC_RETRY_SECONDS=15
#IDENTITY_SYNC_RETRY_MAX_SECONDS=300
#IDENTITY_EVENTS_WINDOW_SECONDS=300
#IDENTITY_EVENTS_TTL_SECONDS=60
