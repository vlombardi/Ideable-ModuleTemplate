# module_template configuration
# Copy to .env.config and adjust values for your module.

# ════════════════════════════════════════════════════════════════
#  Ports & Paths
# ════════════════════════════════════════════════════════════════

# module_template entities DB target (used by template-backend).
# Defaults to the dedicated template-database service.
TEMPLATE_ENTITIES_DB_HOST=template-database
TEMPLATE_ENTITIES_DB_PORT=5432

# module_template authorization DB target (used by authorization.yaml bootstrap input).
# Defaults to host_app DB because authorization is centralized there.
TEMPLATE_AUTH_DB_HOST=database
TEMPLATE_AUTH_DB_PORT=5432

# Published host port for template-database when it is enabled.
TEMPLATE_POSTGRES_PORT=5434

# Host interface the database port is published on. Loopback keeps the DB unreachable
# from outside the host (host-run test suites connect via localhost and keep working).
# Set to 0.0.0.0 only if a remote client genuinely must reach the DB directly; in
# production prefer keeping this on loopback or dropping the mapping entirely.
TEMPLATE_POSTGRES_BIND=127.0.0.1

TEMPLATE_BACKEND_PORT=8002
TEMPLATE_FRONTEND_PORT=3001

# --- horizontal scale ---------------------------------------------------------------------
# Replica count per service. `docker compose up` honours deploy.replicas without Swarm; Traefik
# reaches each service by DNS name and Docker returns every replica's address, so it load-balances
# across them with no configuration change.
#
# The *_PUBLISH keys are the compose port spec, as ONE value, so scaling is an explicit decision:
# `8002:8002` guarantees the documented port (the default, today's behaviour); `8002-8004:8002` is a
# range for >1 replica, at the cost of the base port no longer being guaranteed — measured: with a
# range and one replica, Compose bound the LAST port and left the documented one dead. Raise the
# replica count and widen the publish spec together, and remember that anything pinned to the base
# port must then go through Traefik instead.
TEMPLATE_BACKEND_REPLICAS=1
TEMPLATE_BACKEND_PUBLISH=8002:8002
# scaling: TEMPLATE_BACKEND_PUBLISH=8002-8004:8002
TEMPLATE_FRONTEND_REPLICAS=1
TEMPLATE_FRONTEND_PUBLISH=3001:8080
# scaling: TEMPLATE_FRONTEND_PUBLISH=3001-3003:8080

# host_app integration
HOSTAPP_API_URL=http://backend:8001
HOSTAPP_DB_HOST=database
HOSTAPP_DB_PORT=5432

# Keep this same-origin path (via Traefik) to avoid browser CORS failures that happen
# when the frontend falls back to direct localhost backend URLs from HTTPS host_app pages.
VITE_TEMPLATE_API_URL=/module/template/api

# ════════════════════════════════════════════════════════════════
#  Params
# ════════════════════════════════════════════════════════════════

# Module identity (module-local)
MODULE_SLUG=template
MODULE_NAME=module_template

# Registry prefix for pushing this module's images (used by push script).
# When set, compose image references that will be pulled from a remote registry
# must already include this prefix (e.g. ghcr.io/owner/template.backend:latest).
# Note: when this module is declared as "local" (not "remote") in modules/enabled.md,
# the deploy script strips this prefix from deployed .env.config and .env.secrets files so compose uses locally built images.
MODULE_DOCKER_REGISTRY_PREFIX=ghcr.io/vlombardi

TEMPLATE_ENTITIES_DB_NAME=template_db
TEMPLATE_ENTITIES_DB_USER=template_user

TEMPLATE_AUTH_DB_NAME=vinz
TEMPLATE_AUTH_DB_USER=vinz

AUTHENTIK_JWKS_URL=http://authentik-server:9000/application/o/ideable/jwks/

# How long a fetched JWKS stays fresh, in seconds (default 600). An unknown `kid` also
# forces a refresh, so an Authentik signing-key rotation self-heals without a restart.
AUTHENTIK_JWKS_TTL_SECONDS=600

HOSTAPP_DB_NAME=vinz
HOSTAPP_DB_USER=vinz

VITE_TEMPLATE_LF_MODE=hostapp

# ════════════════════════════════════════════════════════════════
#  Container resource limits (deploy.resources)
# ════════════════════════════════════════════════════════════════
# Caps, not reservations of capacity: they contain a runaway container so it cannot
# starve Postgres or Traefik. Memory reservations are soft (scheduling hints).
# Raise the limits for a busier deployment; keep them set — an unlimited container
# is the failure mode these values exist to prevent.

TEMPLATE_DATABASE_CPU_LIMIT=1
TEMPLATE_DATABASE_MEM_LIMIT=1g
TEMPLATE_DATABASE_MEM_RESERVATION=256m

TEMPLATE_BACKEND_CPU_LIMIT=1
TEMPLATE_BACKEND_MEM_LIMIT=1g
TEMPLATE_BACKEND_MEM_RESERVATION=256m

TEMPLATE_FRONTEND_CPU_LIMIT=0.5
TEMPLATE_FRONTEND_MEM_LIMIT=256m
TEMPLATE_FRONTEND_MEM_RESERVATION=64m

# --- Backend concurrency and DB pool ------------------------------------------------------
# Workers are processes: each one owns its own connection pool, so total connections are
# BACKEND_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW). Keep that under the database's
# max_connections (see the backend framework spec).
BACKEND_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# Per-identity write limit, counted per worker (0 disables it).
RATE_LIMIT_WRITES_PER_MINUTE=120

# --- Audit retention ----------------------------------------------------------------------
# The audit tables are TimescaleDB hypertables. These settings are applied on every deploy by
# scripts/runtime/config/audit-retention.sh, so changing how long history stays online is a
# configuration change — not a migration.
#
# NOTE: values containing spaces MUST be quoted — these files are sourced by shell.
# Chunk size. A build-time shape rather than a policy: it sizes a chunk, and only affects chunks
# created after it changes. Widen it if this deployment writes far more audit data.
AUDIT_CHUNK_INTERVAL="7 days"
# Compress chunks older than this. Typically reclaims well over half the audit footprint.
# Empty disables compression.
AUDIT_COMPRESS_AFTER="90 days"
# Drop chunks older than this. EMPTY BY DEFAULT — nothing is ever deleted unless you set it, and
# it refuses to run unless AUDIT_ARCHIVE_DIR is set (or AUDIT_ARCHIVE_OPTOUT=1), because a
# retention policy running before archival is data loss on a schedule.
AUDIT_RETAIN_FOR=""
# Where expiring rows are exported, with a SHA-256 alongside, before retention drops them.
AUDIT_ARCHIVE_DIR=""

# --- Tenant isolation ---------------------------------------------------------------------
# The backend connects as this restricted role, NOT as the database owner. The owner is a
# superuser, and superusers bypass Row-Level Security unconditionally — connecting as the owner
# makes the tenant policies decorative. Migrations still run as the owner, which needs DDL.
TEMPLATE_APP_DB_USER=template_app
# Tenant assigned to rows that predate tenancy, by the migration's backfill.
DEFAULT_TENANT_ID=1
