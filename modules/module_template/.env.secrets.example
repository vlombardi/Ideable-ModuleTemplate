# module_template secrets — example values
# Copy to .env.secrets and replace placeholders with real values.
# WARNING: Do not commit .env.secrets to version control.

HOSTAPP_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# The database owner's password: the database container, the migrations job and the bootstrap job.
TEMPLATE_ENTITIES_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
# The password of the restricted role the backend connects as (TEMPLATE_APP_DB_USER in
# .env.config). Rotating it here is enough — the bootstrap job runs ALTER ROLE on every deploy.
TEMPLATE_APP_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
