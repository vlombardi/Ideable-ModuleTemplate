{
  "name": "@ideable/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Ideable framework shared UI widget library and design tokens. Consumed by host_app, module_template, and every remote module. Styled with the neutral `ideable:` CSS prefix; branding is achieved by overriding token values, never class names.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.ts",
    "./widgets": "./widgets/index.ts",
    "./widgets/*": "./widgets/*.tsx",
    "./primitives": "./primitives/index.ts",
    "./primitives/*": "./primitives/*.tsx",
    "./hooks/*": "./hooks/*.ts",
    "./lib/*": "./lib/*.ts",
    "./styles": {
      "style": "./styles/compiled.css",
      "default": "./styles/compiled.css"
    },
    "./styles/source": {
      "style": "./styles/index.css",
      "default": "./styles/index.css"
    },
    "./i18n/*": "./i18n/*.json"
  },
  "scripts": {
    "build:css": "tailwindcss -i styles/index.css -o styles/compiled.css"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react-is": "^19.2.0",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3"
  }
}
