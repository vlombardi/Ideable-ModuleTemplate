reusable.ui/**/*.d.ts

# Scratch trees for the verifier scripts (pristine worktrees, staged remote skeletons).
# Inside the repo because only the repo is mounted into the dev tools container.
.ideable-work/

# ================================
# Test Reports — per-run detail
# ================================
# `scripts/common/run_enabled_tests.sh` regenerates every per-module detail report on each run, and
# nothing reads a past one: `dev_cycle.py` folds only the LATEST summary into the plan, and
# `.githooks/pre-push` reads only the newest one. Tracking them put 1835 files / 73 MB in the tree —
# 2077 of ~2800 tracked files were dead reports, which buried real changes in every grep, every
# `git ls-files`, and every diff (`dev_cycle.py` grew `_BOOKKEEPING_PATHS` to keep them out of a
# delivery message's headline count).
#
# The cross-module `<timestamp>-SUMMARY.md` files stay TRACKED and must not be ignored: a plan
# delivery's `Test-Report:` trailer names one, and
# `scripts/TESTS/test_plan_deliveries_say_what_they_did.py` re-adds its tables to prove the commit
# message's test counts were measured rather than claimed. Ignoring them turns that evidence back
# into an assertion.
TEST_REPORTS/*/
