# Ideable framework version — and the dev tools image that goes with it.
#
# This file is FRAMEWORK-OWNED and force-synced: `scripts/module_only/sync-template-updates.sh`
# overwrites it, so a value edited here in a remote module project is replaced on the next sync.
# To change a version for one command, set the variable in your shell instead — the environment
# always wins over this file.
#
# It is deliberately NOT `project.env.config`: that file is deployer-owned, merged into the
# deployed containers' environment, and never overwritten by sync — three properties that are all
# wrong for a value the framework must be able to update and that must never reach a runtime
# container. Nothing here is read by any deployed service.

# The framework version this project tracks. `latest` follows the newest published dev tools image,
# which is the useful setting during framework maintenance; a specific version (e.g. v1.2.0) pins it.
IDEABLE_FRAMEWORK_VERSION=latest

# The dev tools image version. EMPTY MEANS "follow IDEABLE_FRAMEWORK_VERSION", which is the
# supported way to say the two coincide — and they should. Setting it apart is permitted for
# bisecting a toolchain problem, but it is discouraged: it means running a toolbox the framework
# version was never tested against, so the resolver says so out loud every time.
IDEABLE_DEVTOOLS_VERSION=

# GENERATED — written by `scripts/master_only/push_devtools_image_to_registry.sh` at publish time,
# never by hand. The manifest digest of the published image, carried here (rather than only in
# host_app's dependencies.md) because this file is force-synced and that one is not: a remote must
# be able to read it, and a remote has no `modules/host_app/SPECS/`.
#
# `tool.sh` compares it against the local image whenever the resolved version is not `latest`, and
# says so on a mismatch — which means either a tag was re-pushed or the local image was built by
# hand. Empty until the first publish; an empty value disables the check rather than failing.
IDEABLE_DEVTOOLS_DIGEST=sha256:665d1f20bc252fad1f600545d98dfa184cc9d05f464c264cef2ded4aed9114b4
